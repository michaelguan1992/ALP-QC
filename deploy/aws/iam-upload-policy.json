{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UploadAndCheckMasterQCBackups",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectRetention",
        "s3:GetObject",
        "s3:GetObjectRetention"
      ],
      "Resource": "arn:aws:s3:::YOUR-BUCKET-NAME/masterqc/*"
    },
    {
      "Sid": "NeverDeleteOrWeakenBackups",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:BypassGovernanceRetention",
        "s3:PutBucket*",
        "s3:DeleteBucket*"
      ],
      "Resource": [
        "arn:aws:s3:::YOUR-BUCKET-NAME",
        "arn:aws:s3:::YOUR-BUCKET-NAME/*"
      ]
    }
  ]
}
