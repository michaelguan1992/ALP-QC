# Copy this file to /etc/masterqc/env. Owner root, group masterqc, mode 0640.
# systemd reads it as root. Each line is KEY=value; do not add quotes. Empty values count as unset.

# Absolute path of the production data directory. The database is <directory>/masterqc-main.sqlite.
MASTERQC_DATA_DIR=/var/lib/masterqc

# Address that browsers use through Caddy: scheme and host, with an optional port, and no path.
MASTERQC_PUBLIC_ORIGIN=https://qc.example.com

# Keep the application on loopback. Caddy is the only public entry point.
MASTERQC_LISTEN_HOST=127.0.0.1
MASTERQC_LISTEN_PORT=4173

# The demo workspace is for local use only.
MASTERQC_DEMO=off

# Request header that Caddy sets to the signed-in team member's name (see Caddyfile.example). The application records
# it as the operator on audit entries. It is honoured only in hosted mode and only for requests from this computer.
MASTERQC_TRUSTED_USER_HEADER=x-remote-user
